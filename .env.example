# Copy to ".env" and fill in. Nothing here has a default: a variable that a command
# needs and that is unset stops the command with a message naming the variable.

# Where lecture recordings and preprocessing artefacts live, and where outputs go.
AD_FOR_EDU_DATA_DIR=
AD_FOR_EDU_WORK_DIR=

# Hub dataset ids, in the form "namespace/name". The published sets are
#   Psychias/AD4Edu-SFT          reference descriptions and the training examples
#   Psychias/AD4Edu-Preferences  the pairs, and the 400 rated by people
#   Psychias/AD4Edu-keyframes    one directory of frames per lecture
# They are left blank rather than filled in, so that a command reads the set you
# meant and not a default someone else chose. Set "source: local_dir" in
# configs/data.yaml to point these at directories of the same shape instead.
AD_FOR_EDU_REFERENCES_DATASET=
AD_FOR_EDU_PREFERENCES_DATASET=
AD_FOR_EDU_KEYFRAMES_DATASET=

# Credentials. Only the commands that call a hosted model read these.
HF_TOKEN=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
